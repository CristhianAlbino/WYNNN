# Banco de dados
MONGO_URI=mongodb://127.0.0.1:27017/wyn_project

# Aplicação
NODE_ENV=development
JWT_SECRET=troque-por-uma-chave-forte
BACKEND_BASE_URL=http://localhost:3000
CLIENT_BASE_URL=http://localhost:5500

# E-mail
EMAIL_SERVICE=gmail
EMAIL_USER=seu-email@example.com
EMAIL_PASS=sua-senha-de-app

# Gemini
GEMINI_API_KEY=sua-chave

# Mercado Pago
MP_ACCESS_TOKEN=seu-access-token
MP_WEBHOOK_URL=https://seu-dominio.example/webhook

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=seu-account-sid
TWILIO_AUTH_TOKEN=seu-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+000000000000
